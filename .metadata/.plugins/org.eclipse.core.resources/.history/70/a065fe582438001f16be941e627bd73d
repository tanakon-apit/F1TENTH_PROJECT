HAL_StatusTypeDef resetTracking(PAA5160E1_Structure *paa)
{
	// Set tracking reset bit
	uint8_t txbuffer;
	txbuffer = 0x01;
	return HAL_I2C_Mem_Write(paa->hi2cx, paa->address, kRegReset, 1, &, 1, 10);
}

